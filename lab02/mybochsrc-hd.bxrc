# Bochs configuration for macOS/Homebrew Bochs 3.0.
# Lab environment: Linux 0.11 + Bochs.

config_interface: textconfig
display_library: sdl2

memory: host=32, guest=32
romimage: file=$BXSHARE/BIOS-bochs-latest, options=fastboot
vgaromimage: file=$BXSHARE/VGABIOS-lgpl-latest.bin

boot: floppy
floppy_bootsig_check: disabled=0
floppya: type=1_44, 1_44="/Users/qi7876/dev/OS_2026_Spring/lab02/lab2-linux-bochs/bootimage-0.11-hd", status=inserted, write_protected=0
floppyb: type=1_44, 1_44="/Users/qi7876/dev/OS_2026_Spring/lab02/lab2-linux-bochs/diska.img", status=inserted, write_protected=0

ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=disk, mode=flat, translation=auto, path="/Users/qi7876/dev/OS_2026_Spring/lab02/lab2-linux-bochs/hdc-0.11-new.img", cylinders=410, heads=16, spt=38, biosdetect=auto, model=""
ata1: enabled=1, ioaddr1=0x170, ioaddr2=0x370, irq=15
ata2: enabled=0
ata3: enabled=0

parport1: enabled=1, file=""
parport2: enabled=0
com1: enabled=1, mode=null, dev=""
com2: enabled=0
com3: enabled=0
com4: enabled=0

usb_uhci: enabled=0
pci: enabled=1, chipset=i440fx
vga: extension=vbe, update_freq=5

cpu: model=pentium, count=1, ips=4000000, reset_on_triple_fault=1, ignore_bad_msrs=1
cpu: cpuid_limit_winnt=0

print_timestamps: enabled=0
port_e9_hack: enabled=0
clock: sync=none, time0=local

log: -
logprefix: %t%e%d
panic: action=ask
error: action=report
info: action=report
debug: action=ignore

keyboard: type=mf, serial_delay=250, paste_delay=100000
mouse: enabled=0, type=ps2, toggle=ctrl+mbutton
